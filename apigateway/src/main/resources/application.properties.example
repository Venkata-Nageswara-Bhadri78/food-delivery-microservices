spring.application.name=apigateway
server.port=8080

# Backend Services
services.auth.url=lb://AUTH-SERVICE
services.restaurant.url=lb://RESTAURANT-SERVICE
services.customer.url=lb://CUSTOMER-SERVICE
services.agent.url=lb://AGENT-SERVICE
services.admin.url=lb://ADMIN-SERVICE

# Gateway Routes

# 1. AUTH SERVICE
spring.cloud.gateway.server.webflux.routes[0].id=auth-service
spring.cloud.gateway.server.webflux.routes[0].uri=${services.auth.url}
spring.cloud.gateway.server.webflux.routes[0].predicates[0]=Path=/api/auth/**
spring.cloud.gateway.server.webflux.routes[0].filters[0]=StripPrefix=2

# RESTAURANT SERVICE
spring.cloud.gateway.server.webflux.routes[1].id=restaurant-service
spring.cloud.gateway.server.webflux.routes[1].uri=${services.restaurant.url}
spring.cloud.gateway.server.webflux.routes[1].predicates[0]=Path=/api/restaurant/**
spring.cloud.gateway.server.webflux.routes[1].filters[0]=StripPrefix=2

# CUSTOMER SERVICE
spring.cloud.gateway.server.webflux.routes[2].id=customer-service
spring.cloud.gateway.server.webflux.routes[2].uri=${services.customer.url}
spring.cloud.gateway.server.webflux.routes[2].predicates[0]=Path=/api/customer/**
spring.cloud.gateway.server.webflux.routes[2].filters[0]=StripPrefix=2

# AGENT SERVICE
spring.cloud.gateway.server.webflux.routes[3].id=agent-service
spring.cloud.gateway.server.webflux.routes[3].uri=${services.agent.url}
spring.cloud.gateway.server.webflux.routes[3].predicates[0]=Path=/api/agent/**
spring.cloud.gateway.server.webflux.routes[3].filters[0]=StripPrefix=2



# ADMIN SERVICE
spring.cloud.gateway.server.webflux.routes[4].id=admin-service
spring.cloud.gateway.server.webflux.routes[4].uri=${services.admin.url}
spring.cloud.gateway.server.webflux.routes[4].predicates[0]=Path=/api/admin/**
spring.cloud.gateway.server.webflux.routes[4].filters[0]=StripPrefix=2

# JWT Token
jwt.secret=<YOU_JWT_SECRET_CODE>
jwt.expiration=86400000

# Eureka Server
eureka.client.service-url.defaultZone=http://localhost:8761/eureka/

# Acuator
management.endpoints.web.exposure.include=health,info

eureka.instance.prefer-ip-address=true