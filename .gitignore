
# ==========================================
# Maven / Spring Boot
# ==========================================
**/target/
**/build/
**/out/

# ==========================================
# IDE files
# ==========================================
.idea/
*.iml
.vscode/
.classpath
.project
.settings/
.factorypath
.springBeans
.sts4-cache/

# ==========================================
# Environment variables and secrets
# ==========================================
.env
.env.*
!.env.example
!.env.*.example
**/secrets/
**/*-secret.properties
**/*-secrets.properties

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# ==========================================
# Local application configuration
# Ignore actual properties files, but keep examples
# ==========================================
**/src/main/resources/application.properties
**/src/main/resources/application-*.properties
!**/src/main/resources/application.properties.example
!**/src/main/resources/application-*.properties.example

# ==========================================
# Logs and temporary files
# ==========================================
*.log
logs/
tmp/
temp/
*.tmp
*.swp
*.swo
*~

# ==========================================
# Operating system files
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# ==========================================
# Test and coverage output
# ==========================================
**/test-output/
**/coverage/
**/jacoco.exec

# ==========================================
# Local databases and application data
# ==========================================
*.db
*.sqlite
*.sqlite3
